<nav class="sticky top-0 w-full bg-medium text-light border-b border-light shadow-xl z-50">
  <div class="w-full mx-auto flex justify-between items-center py-1 px-5">
    
    <!-- Logo -->
    <a href="/#home" class="text-lg font-semibold hover:text-white">KT</a>

    <!-- Hamburger (mobile) -->
    <button id="nav-toggle" aria-label="Toggle navigation" class="md:hidden focus:outline-none z-30">
      <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Menu -->
    <ul
      id="nav-menu"
      class="absolute top-full right-0 bg-accent md:bg-transparent text-white shadow-xl md:shadow-none md:static md:flex flex-col md:flex-row items-center justify-end space-y-3 md:space-y-0 md:space-x-5 mt-px md:mt-1 uppercase text-sm max-h-0 overflow-hidden md:overflow-visible transition-all duration-300 ease-in-out text-right md:max-h-full"
    >
      <li class="pt-3 md:pt-0 px-3 md:px-0">
        <a class="hover:text-dark" href="/#home">Home</a>
      </li>
      <li class="px-3 md:px-0">
        <a class="hover:text-dark" href="/#skills">Skills</a>
      </li>
      <li class="px-3 md:px-0">
        <a class="hover:text-dark" href="/#work">Work</a>
      </li>
      <li class="pb-3 px-3 md:pb-0 md:px-0">
        <a class="hover:text-dark" href="/#contact">Contact</a>
      </li>
    </ul>
  </div>

  <!-- Social nav (desktop only) -->
  <div class="hidden lg:flex">
    <slot />
  </div>
</nav>

<script>
  const toggleButton = document.getElementById('nav-toggle');
  const navMenu = document.getElementById('nav-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  const openMenu = () => {
    navMenu.classList.remove('max-h-0');
    navMenu.classList.add('max-h-screen');
    hamburgerIcon.classList.add('hidden');
    closeIcon.classList.remove('hidden');
  };

  const closeMenu = () => {
    navMenu.classList.remove('max-h-screen');
    navMenu.classList.add('max-h-0');
    hamburgerIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
  };

  toggleButton.addEventListener('click', () => {
    if (navMenu.classList.contains('max-h-0')) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  // Close when clicking a link
  navMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Safer outside click
  document.addEventListener('click', (e) => {
    const isInside = navMenu.contains(e.target) || toggleButton.contains(e.target);

    if (!isInside && navMenu.classList.contains('max-h-screen')) {
      closeMenu();
    }
  });

  // Handle resize
  const handleResize = () => {
    if (window.innerWidth >= 768) {
      navMenu.classList.remove('max-h-0');
      navMenu.classList.add('max-h-full');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.add('hidden');
    } else {
      navMenu.classList.remove('max-h-full');
      navMenu.classList.add('max-h-0');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  };

  window.addEventListener('resize', handleResize);
  handleResize();
</script>