---
import ArrowRight from "../assets/icons/ArrowRight.astro";
---

<section id="home" class="max-w-screen-lg mx-auto">
  <div class="w-full mt-4 flex flex-col px-5 lg:px-[120px] xl:px-24 text-light">
    <h1 class="text-5xl lg:text-7xl text-lightest">
      Kara Thurmond
    </h1>

    <h2 class="text-2xl lg:text-5xl text-light">
      Senior Front-end Web Developer
    </h2>

    <p class="text-xl lg:text-3xl text-medium lg:pr-5">
      I&#8217;m a senior frontend developer with 10+ years of experience translating
      UI/UX designs into polished, production-ready websites. Expert in HTML, CSS,
      and Tailwind CSS, with deep experience building scalable component systems and
      performance-focused frontend architectures. Known for pixel-perfect
      implementation, performance-focused builds, and close collaboration with
      designers to bring complex layouts to life.
    </p>

    <a href="#work" class="my-6 w-fit">
      <button
        class="flex group items-center hover:border-accent rounded-full py-3 px-4 border border-white text-light hover:text-accent font-semibold"
      >
        <span class="pr-0.5">View Work</span>
        <span class="group-hover:rotate-90 duration-200">
          <ArrowRight />
        </span>
      </button>
    </a>
  </div>
</section>
