---
import ArrowRight from "../assets/icons/ArrowRight.astro";
---

<section id="home" class="max-w-screen-lg mx-auto scroll-mt-20">
  <div class="w-full mt-4 flex flex-col px-5 lg:px-[120px] xl:px-24 text-light">
    <h1 class="text-5xl lg:text-7xl text-lightest">
      Kara Thurmond
    </h1>

    <h2 class="text-2xl lg:text-5xl text-light">
      Senior Front-end Web Developer
    </h2>

    <p class="text-xl lg:text-3xl text-medium lg:pr-5">
     Senior Frontend Developer with extensive experience building accessible, responsive, and user-focused web interfaces. Originally trained as a graphic designer, I bring a strong foundation in visual design, usability, and frontend implementation, combining technical expertise with a thoughtful approach to UI/UX. Experienced in delivering maintainable, production-ready solutions across custom applications, websites, and long-lived codebases.
    </p>

    <a href="#work" class="my-6 w-fit">
      <button
        class="flex group items-center hover:border-accent rounded-full py-3 px-4 border border-white text-light hover:text-accent font-semibold"
      >
        <span class="pr-0.5">View Work</span>
        <span class="group-hover:rotate-90 duration-200">
          <ArrowRight />
        </span>
      </button>
    </a>
  </div>
</section>
